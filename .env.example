# ------------------------------------------------------------------
# Shared environment template. Copy to .env and adjust values.
# Per-service templates: frontend/.env.example, backend/.env.example,
# ai/.env.example
# ------------------------------------------------------------------

# --- Database -----------------------------------------------------
POSTGRES_DB=smiu_assistant
POSTGRES_USER=smiu
POSTGRES_PASSWORD=smiu
POSTGRES_PORT=5432

# --- Backend ------------------------------------------------------
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://smiu:smiu@localhost:5432/smiu_assistant
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI service ---------------------------------------------------
AI_PORT=8001

# --- Frontend -----------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AI_API_URL=http://localhost:8001

# --- AI providers -------------------------------------------------
OPENAI_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=smiu-ai-assistant
