# FastAPI backend service. Copy to .env and adjust values.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

APP_NAME=smiu-ai-assistant-backend
VERSION=0.1.0
API_VERSION=1.0

HOST=0.0.0.0
PORT=8000

# SQLite for local development. PostgreSQL in production (async driver; sync
# postgresql:// URLs are normalized to asyncpg automatically):
# DATABASE_URL=postgresql+asyncpg://smiu:smiu@localhost:5432/smiu_assistant
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

# Connection pool (PostgreSQL only)
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000

# Request / correlation id headers
REQUEST_ID_HEADER=X-Request-Id
CORRELATION_ID_HEADER=X-Correlation-Id

# OpenAPI docs (enabled by default; disabled automatically in production)
# DOCS_URL=/docs
# REDOC_URL=/redoc
# OPENAPI_URL=/openapi.json

# --- Authentication ----------------------------------------------------
# JWT signing secret (REQUIRED in production; use a long random string)
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=smiu-ai-assistant
JWT_AUDIENCE=smiu-ai-assistant-api

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_EXPIRE_DAYS=30
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30

# Account lockout (after N failed logins, lock for M minutes)
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# Base URL of the frontend used to build verification/reset links
FRONTEND_BASE_URL=http://localhost:3000

# Path (relative to FRONTEND_BASE_URL) that renders the reset-password page;
# the signed token is appended as ?token=<token>
FRONTEND_RESET_PATH=reset-password

# --- File storage ------------------------------------------------------
# Base directory for uploaded files (relative to backend working directory)
STORAGE_PATH=storage/uploads
# Maximum upload file size in megabytes
MAX_UPLOAD_SIZE_MB=10

# --- Email (Gmail SMTP) ------------------------------------------------
# Enable only when SMTP credentials are configured. Use a Gmail App Password
# (account 2FA required); never commit the password.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- AI / RAG ----------------------------------------------------------
# LLM provider: gemini, groq, or openai
LLM_PROVIDER=gemini

# LLM provider API key
# Replace this placeholder locally with a real key.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional provider keys for switching providers later.
# Keep them empty by default.
GROQ_API_KEY=
OPENAI_API_KEY=

# Sentence Transformers embedding model used by the existing RAG system.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Existing FAISS vector store location.
# This must point to the repository-level knowledge/vectorstore directory.
VECTOR_STORE_PATH=../knowledge/vectorstore

# Existing knowledge document root used by the existing reindexer.
KNOWLEDGE_ROOT=../knowledge
