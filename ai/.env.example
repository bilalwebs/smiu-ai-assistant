# AI service. Copy to .env and adjust values.

# --- LLM gateway (AI_ARCHITECTURE.md §35) ----------------------------------
# Active provider: gemini | openai | groq. Only the active provider's key is
# required (enforced by the gateway factory at construction time).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Provider-appropriate default model ids; set the active provider's model
# below, or override generically with LLM_MODEL.
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=llama-3.1-8b-instant

# Generic active-model override (empty = use the provider default).
LLM_MODEL=
# In-provider fallback model used when the primary is unavailable (§35.6).
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# Embeddings
EMBEDDING_MODEL=

# LangSmith tracing
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=smiu-ai-assistant

# RAG
RAG_TOP_K=4
# Global context budget for grounded generation (§17.3).
CONTEXT_BUDGET_TOKENS=4096
VECTOR_STORE_URL=postgresql://smiu:smiu@localhost:5432/smiu_assistant

# Memory / chat
CHAT_HISTORY_LIMIT=20

# Backend API
BACKEND_API_URL=http://localhost:8000
