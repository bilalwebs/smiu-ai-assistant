# AI service. Copy to .env and adjust values.

# LLM / embeddings
OPENAI_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# LangSmith tracing
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=smiu-ai-assistant

# RAG
RAG_TOP_K=4
VECTOR_STORE_URL=postgresql://smiu:smiu@localhost:5432/smiu_assistant

# Memory / chat
CHAT_HISTORY_LIMIT=20

# Backend API
BACKEND_API_URL=http://localhost:8000
