# Normalize line endings: LF on check-in for all text files.
* text=auto eol=lf

# Windows-specific files keep CRLF on check-out.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Declare binary formats so Git does not mangle them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
